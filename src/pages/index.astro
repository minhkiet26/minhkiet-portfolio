---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portfolio cá nhân của Minh Kiệt — sinh viên năm 3 ngành Kỹ thuật phần mềm. Khám phá dự án VNZ-DNA và SEAL Hackathon." />
    <meta name="theme-color" content="#f5f7f2" />
    <title>Minh Kiệt — Personal space</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('mk-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link" data-i18n="skip">Đi tới nội dung</a>
    <main id="main">
      <section class="page-screen home-screen" id="home" aria-labelledby="hero-title" tabindex="0">
        <div class="screen-content home-content">
          <div class="home-main">
    <header class="header shell">
      <a href="#home" class="brand" aria-label="Minh Kiệt"><span class="brand-mark">mk<span>✳</span></span><span class="brand-caption">PERSONAL SPACE / 2026</span></a>
      <div class="header-actions"><span class="local-note" data-i18n="welcome">Rất vui vì bạn ghé qua!</span><div class="language" role="group" aria-label="Language"><button data-lang="vi" aria-pressed="true">VI</button><span>/</span><button data-lang="en" aria-pressed="false">EN</button></div><button class="theme-button" id="theme-toggle" aria-label="Đổi giao diện sáng tối"><span class="sun"><Icon name="sun" size={19}/></span><span class="moon"><Icon name="moon" size={19}/></span></button></div>
    </header>
      <div class="hero shell">
        <div class="hero-copy">
          <div class="eyebrow build-item"><span class="status-dot"></span><span data-i18n="hello">XIN CHÀO, MÌNH LÀ</span><span class="tiny-star">✳</span></div>
          <h1 id="hero-title" class="build-item">Minh <span>Kiệt<span class="title-dot">.</span></span></h1>
          <div class="hero-description build-item"><span class="scribble">↳</span><p data-i18n="intro">Sinh viên năm 3<br/>ngành Kỹ thuật phần mềm.</p></div>
          <p class="hero-note build-item" data-i18n="introNote">Một góc nhỏ để chia sẻ những điều mình học,<br/>những dự án mình làm và hành trình đang tiếp nối.</p>
          <div class="hero-buttons build-item"><a class="button primary" href="#projects"><span data-i18n="explore">Khám phá dự án</span><Icon name="arrow" size={18}/></a><a class="text-link" href="https://github.com/minhkiet26" target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" size={16}/></a></div>
          <button id="replay" class="replay" hidden><Icon name="replay" size={14}/><span data-i18n="replay">Xem con trỏ dựng lại mục này</span></button>
        </div>
        <div class="portrait-area build-item">
          <div class="portrait-outline"></div><div class="portrait-window"><div class="window-bar"><span class="traffic"><i></i><i></i><i></i></span><span>hello-world.jpg</span><Icon name="external" size={13}/></div><div class="portrait-image"><img src="/images/minh-kiet.png" alt="Minh Kiệt mỉm cười trước một quầy hàng màu vàng" width="1919" height="1279" fetchpriority="high"/><div class="photo-caption"><span data-i18n="photoNote">Một chút mình, ngoài những dòng code.</span><span>↗</span></div></div></div>
          <div class="floating-sticker yellow"><span>✳</span><span data-i18n="sticker">Luôn tò mò.<br/>Luôn học hỏi.</span></div>
          <div class="floating-tag"><span class="status-dot"></span><span>learning, building, growing</span></div><span class="portrait-doodle">✧</span>
        </div>
        <div class="hero-bottom"><span>01 / A LITTLE INTRODUCTION</span><a href="#projects"><span data-i18n="scroll">Còn nhiều điều bên dưới</span> ↓</a><span class="coordinates">&lt;make something meaningful /&gt;</span></div>
      </div>
          </div>
      <div class="ticker build-item" aria-hidden="true"><div class="ticker-track">{[0, 1].map(() => <div class="ticker-copy">C# <span>✳</span> ASP.NET CORE <span>✳</span> BUILD. LEARN. REPEAT. <span>✳</span> DOCKER <span>✳</span> POSTGRESQL <span>✳</span> LITTLE IDEAS, REAL PROJECTS <span>✳</span></div>)}</div></div>
        </div>
      </section>
      <section class="page-screen" id="projects" aria-labelledby="projects-title" tabindex="0"><div class="screen-content projects shell section">
        <div class="section-heading"><div><span class="section-index" data-i18n="projectsLabel">02 / NHỮNG ĐIỀU MÌNH ĐÃ LÀM</span><h2 id="projects-title" data-i18n="projectsTitle">Từ ý tưởng<br/>đến <em>dự án.</em></h2></div><p data-i18n="projectsNote">Học bằng cách bắt tay vào làm.<br/>Hai dự án môn học, nhiều điều để khám phá.</p></div>
        <div class="project-grid">
        <article class="project-card vnz"><div class="project-art"><div class="art-top"><span>PROJECT / 01</span><span>BACKEND DEVELOPMENT</span></div><div class="vnz-art"><div class="vnz-logo">VNZ<span>DNA</span><i>®</i></div><p>CONTENT. CONNECTION. CULTURE.</p><div class="architecture"><span><Icon name="grid" size={17}/> API</span><i>→</i><span><Icon name="code" size={17}/> Service</span><i>→</i><span><Icon name="server" size={17}/> PostgreSQL</span></div></div><div class="art-bottom"><span>ASP.NET CORE / POSTGRESQL</span><span>↗</span></div></div><div class="project-info"><div class="project-meta"><span data-i18n="coursework">DỰ ÁN MÔN HỌC</span><span>09 — 10 / 2026</span></div><h3>VNZ-DNA</h3><p data-i18n="vnzDesc">Backend cho website giới thiệu doanh nghiệp: quản lý nội dung, sản phẩm, tuyển dụng và kết nối với người dùng.</p><div class="tags"><span>C#</span><span>ASP.NET Core</span><span>PostgreSQL</span><span>Docker</span><span>Render</span></div><div class="project-footer"><span class="team"><Icon name="user" size={15}/><span data-i18n="team3">Nhóm 3 người</span></span><button class="detail-link" data-project="vnz"><span data-i18n="details">Khám phá dự án</span><Icon name="arrow" size={18}/></button></div></div></article>
        <article class="project-card seal"><div class="project-art"><div class="art-top"><span>PROJECT / 02</span><span>CLEAN ARCHITECTURE</span></div><div class="seal-art"><span class="seal-orbit orbit-one"></span><span class="seal-orbit orbit-two"></span><div class="seal-logo">SEAL<span>HACKATHON MANAGER</span></div><div class="seal-nodes"><span>TEAM</span><span>BUILD</span><span>SCORE</span></div><span class="seal-spark">✳</span></div><div class="art-bottom"><span>.NET 8 / CLEAN ARCHITECTURE</span><span>↗</span></div></div><div class="project-info"><div class="project-meta"><span data-i18n="coursework">DỰ ÁN MÔN HỌC</span><span>06 — 08 / 2026</span></div><h3>SEAL Hackathon</h3><p data-i18n="sealDesc">Hệ thống quản lý cuộc thi hackathon: từ đội thi, nộp bài đến chấm điểm, bảng xếp hạng và thông báo.</p><div class="tags"><span>C#</span><span>.NET 8</span><span>Clean Architecture</span><span>EF Core</span></div><div class="project-footer"><span class="team"><Icon name="user" size={15}/><span data-i18n="team4">Nhóm 4 người</span></span><button class="detail-link" data-project="seal"><span data-i18n="details">Khám phá dự án</span><Icon name="arrow" size={18}/></button></div></div></article>
        </div>
        <p class="project-footnote"><span class="status-dot"></span><span data-i18n="honesty">Cả hai là dự án học tập, chưa có người sử dụng thực tế. Hình phía trên là đồ họa giới thiệu dự án.</span></p>
      </div></section>
      <section id="about" class="page-screen about-section" aria-labelledby="about-title" tabindex="0"><div class="screen-content shell section about-copy"><span class="section-index" data-i18n="aboutLabel">03 / MỘT CHÚT VỀ MÌNH</span><h2 id="about-title" data-i18n="aboutTitle">Học từng chút.<br/><em>Làm từng bước.</em></h2><p class="about-text" data-i18n="aboutText">Mình là Kiệt, sinh viên năm 3 ngành Kỹ thuật phần mềm. C# là ngôn ngữ chính mình sử dụng. Mình thích hiểu cách một request đi qua API, xử lý nghiệp vụ và làm việc với database.</p><p class="about-text secondary" data-i18n="aboutText2">Qua các dự án nhóm, mình có cơ hội viết Backend, áp dụng Clean Architecture và triển khai ứng dụng. Góc nhỏ này lưu lại những gì mình đã làm và đang tiếp tục học.</p><a class="text-link" href="https://github.com/minhkiet26" target="_blank" rel="noopener noreferrer"><span data-i18n="githubVisit">Ghé GitHub của mình</span><Icon name="external" size={16}/></a></div></section>
      <section id="skills" class="page-screen" aria-labelledby="skills-title" tabindex="0"><div class="screen-content shell section skills-layout"><div class="skills-heading"><span class="section-index" data-i18n="skillsLabel">04 / NHỮNG CÔNG CỤ QUEN THUỘC</span><h2 id="skills-title" data-i18n="skillsTitle">Từ những gì học được,<br/><em>bắt tay vào làm.</em></h2></div><div class="toolbox"><div class="toolbox-title"><Icon name="code"/><span data-i18n="toolbox">Trong chiếc hộp công cụ</span><span>↙</span></div><div class="skill-group"><span class="skill-label" data-i18n="mainLanguage">NGÔN NGỮ CHÍNH</span><div class="skill-main"><span class="csharp">C#</span><div><strong>C# & ASP.NET Core</strong><span data-i18n="backend">Xây dựng Backend & API</span></div><span class="skill-star">✳</span></div></div><div class="skill-group"><span class="skill-label" data-i18n="used">ĐÃ LÀM VIỆC VỚI</span><div class="skill-pills"><span>MySQL</span><span>PostgreSQL</span><span>Docker</span><span>CI/CD</span><span>VPS</span><span>Render</span><span>Clean Architecture</span></div></div><div class="skill-group"><span class="skill-label" data-i18n="also">ĐÃ LÀM QUA</span><div class="skill-pills muted"><span>HTML</span><span>CSS</span><span>Java</span></div></div><div class="learning-note"><span>↗</span><p data-i18n="testing">Unit Test: đã học qua, đang tích lũy thêm kinh nghiệm thực hành.</p></div></div></div></section>
      <section class="page-screen" id="contact" aria-labelledby="contact-title" tabindex="0"><div class="screen-content contact shell section"><span class="section-index" data-i18n="contactLabel">05 / GIỮ KẾT NỐI NHÉ</span><div class="contact-heading"><h2 id="contact-title" data-i18n="contactTitle">Một lời chào,<br/>một <em>kết nối mới.</em></h2><span class="contact-flower">✳</span></div><div class="contact-bottom"><a class="email-link" href="mailto:minhkietpham8@gmail.com">minhkietpham8@gmail.com <Icon name="external" size={25}/></a><div class="socials"><a href="https://github.com/minhkiet26" target="_blank" rel="noopener noreferrer"><Icon name="github" size={18}/>GitHub ↗</a><a href="https://www.linkedin.com/in/ki%E1%BB%87t-minh-395454310/" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={18}/>LinkedIn ↗</a></div></div>
    <footer class="footer shell"><span>© 2026 Minh Kiệt</span><span data-i18n="made">Một góc nhỏ, được làm bằng Astro & GSAP.</span><a href="#home" data-i18n="backTop">Lên đầu trang ↑</a></footer>
      </div></section>
    </main>
    <nav class="dock" aria-label="Điều hướng chính"><a href="#home" class="dock-item active" data-nav="home" aria-label="Trang chủ"><span class="dock-icon mint"><Icon name="home" size={24}/></span><span class="dock-tooltip" data-i18n="navHome">Trang chủ</span></a><a href="#projects" class="dock-item" data-nav="projects" aria-label="Dự án"><span class="dock-icon blue"><Icon name="grid" size={24}/></span><span class="dock-tooltip" data-i18n="navProjects">Dự án</span></a><a href="#about" class="dock-item" data-nav="about" aria-label="Về mình"><span class="dock-icon yellow"><Icon name="user" size={24}/></span><span class="dock-tooltip" data-i18n="navAbout">Về mình</span></a><a href="#skills" class="dock-item" data-nav="skills" aria-label="Kỹ năng"><span class="dock-icon green"><Icon name="code" size={24}/></span><span class="dock-tooltip" data-i18n="navSkills">Kỹ năng</span></a><span class="dock-divider"></span><a href="#contact" class="dock-item" data-nav="contact" aria-label="Liên hệ"><span class="dock-icon lavender"><Icon name="mail" size={24}/></span><span class="dock-tooltip" data-i18n="navContact">Liên hệ</span></a></nav>
    <div id="swarm-layer" aria-hidden="true">{['builder', 'designer', 'explorer', 'maker', 'thinker', 'tester', 'learner'].map((name, index) => <div class={`swarm-cursor ${['mint', 'blue', 'yellow'][index % 3]}`}><Icon name="cursor" size={30}/><span>{name}</span></div>)}</div>
    <div class="swarm-status" id="swarm-status" role="status" aria-live="polite" hidden><span data-i18n="tourLabel">Đã xem</span> <span id="swarm-progress"></span><span data-i18n="tourHint">Chọn các mục trên Dock để mở cuộn</span></div>
    <button id="skip-animation" class="skip-animation" hidden data-i18n="skipAnimation">Bỏ qua hiệu ứng →</button>
    <dialog id="project-dialog"><div class="dialog-top"><span class="section-index" data-i18n="projectStory">PROJECT NOTES / CHUYỆN DỰ ÁN</span><button id="close-dialog" aria-label="Đóng"><Icon name="close"/></button></div><div id="dialog-content"></div></dialog>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
